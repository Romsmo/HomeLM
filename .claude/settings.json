{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker-compose down -v:*)",
      "Bash(*docker system prune*)",
      "Bash(*docker volume rm*)",
      "Bash(*docker volume prune*)",
      "Bash(*down -v*)",
      "Bash(*rm -rf*)",
      "Bash(*nft *)",
      "Bash(*mkfs*)",
      "Bash(*apt upgrade*)",
      "Bash(*apt full-upgrade*)",
      "Bash(*reboot*)",
      "Bash(*shutdown*)"
    ]
  }
}
