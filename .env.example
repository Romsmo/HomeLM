# Kopieren nach .env und anpassen. Keine echten Werte ins Repo.

# Netzwerk (nur docker-compose): an welche Adresse/Port auf dem Host gebunden wird.
# Auf dem Server: CAT_BIND_ADDR=192.168.0.10 (niemals 0.0.0.0, der Server ist über Caddy öffentlich).
CAT_BIND_ADDR=127.0.0.1
# HTTPS-Port (nur wenn data/certs/server.crt und server.key existieren, docs/https.md).
# 8443 belegt openHAB, darum 8490.
CAT_TLS_HOST_PORT=8490
# Reverse-Proxy (Caddy) vor Cat, z. B. ai.catscastlecloud.de (docs/public-access.md). Netz von Caddy:
CAT_TRUSTED_PROXIES=
CAT_HOST_PORT=8090
# Benutzer im Container = Besitzer von ./data auf dem Host (Server: id -u / id -g des Deploy-Benutzers).
CAT_UID=10001
CAT_GID=10001

# Backend
CAT_LOG_LEVEL=info

# Login der Weboberfläche. Ohne Passwort ist kein Login möglich. Eigenes, langes Passwort wählen.
CAT_PASSWORD=
# Schlüssel für Sitzungs-Cookies (zufällige lange Zeichenfolge). Leer: Sitzungen enden bei jedem Neustart.
CAT_SESSION_SECRET=

# Lokal zuerst (empfohlen, docs/claude.md): Das Modell auf dem Server (Ollama) beantwortet alles
# selbst, Claude nur das, was es nicht kann. Voraussetzung: "docker compose --profile offline up -d
# ollama" und "docker compose exec ollama ollama pull <Modell>". Leer = alter Cloud-Modus (unten).
CAT_LOCAL_MODEL=qwen3:4b-instruct-2507-q4_K_M
CAT_LOCAL_THREADS=3
CAT_LOCAL_NUM_CTX=4096
CAT_LOCAL_KEEP_ALIVE=10m
# Claude über das Abo (kein API-Schlüssel nötig): Brücke starten mit "--profile claude", Token in
# claude.env eintragen (docs/claude.md). Leer = Claude aus.
CAT_CLAUDE_URL=
CAT_CLAUDE_MODEL=sonnet
CAT_CLAUDE_DAILY_LIMIT=25
# Darf Claude das Gedächtnis (Notizen) lesen? Nur lesend.
CAT_CLAUDE_MEMORY=true

# Alter Cloud-Modus (nur wenn CAT_LOCAL_MODEL leer ist). Der Schlüssel kostet Geld pro Anfrage und
# ist für den Abo-Weg NICHT nötig; ist er gesetzt, hat das mit der Claude-Brücke nichts zu tun.
# Den Schlüssel selbst eintragen, nie im Chat oder im Repo. Ausgabenlimit beim Anbieter setzen.
ANTHROPIC_API_KEY=
CAT_LLM_MODEL=anthropic/claude-haiku-5-5
# "agent" (Standard) oder "echo" (nur Echo, zum Testen der Oberfläche ohne LLM)
CAT_RESPONDER=agent

# Plugins (kommagetrennt): system, weather, openhab, homeassistant (nur mit Home Assistant).
CAT_PLUGINS=system,weather,openhab

# Gerätesteuerung: readonly (nur lesen, Standard), test (nur Testgeräte), full (alle Allowlist-Geräte).
# Erst nach ausdrücklicher Freigabe auf full stellen. Siehe docs/devices.md.
CAT_DEVICE_CONTROL=readonly
# openHAB läuft im Host-Netzwerk des Servers. Aus dem Container ist der Host das Gateway des festen
# Cat-Subnetzes (172.28.250.1). Token ist optional.
CAT_OPENHAB_URL=http://172.28.250.1:8080
CAT_OPENHAB_TOKEN=
# Wetter-Widget (Open-Meteo, ohne Schlüssel). Ohne Koordinaten zeigt das Widget einen Hinweis.
CAT_WEATHER_LAT=
CAT_WEATHER_LON=
CAT_WEATHER_NAME=

# Lernen aus Wiederholungen (docs/learning.md): Was das Modell mehrfach gleich löst, geht danach
# sofort und ohne Modell. CAT_LEARN_AFTER = so oft muss dieselbe Anfrage gleich gelöst werden.
CAT_LEARN=true
CAT_LEARN_AFTER=2

# Gedächtnis (Phase 8)
CAT_SESSION_LOG=true
CAT_SUMMARIZE_SESSIONS=true

# Offline-Fallback im alten Cloud-Modus: leer = aus. Siehe docs/offline.md (RAM-Bedarf ca. 3 GB).
# Mit CAT_LOCAL_MODEL ist das lokale Modell ohnehin die erste Wahl, dann entfällt diese Zeile.
# Beispiel: CAT_FALLBACK_MODEL=ollama_chat/qwen3:4b-instruct-2507-q4_K_M
CAT_FALLBACK_MODEL=
CAT_OLLAMA_URL=http://ollama:11434

# Code-Sandbox (Tool run_python, Container homelm-sandbox). Siehe docs/sandbox.md.
CAT_SANDBOX=true

# Sprache (Phase 6). Braucht ca. 600 MB RAM und beim ersten Start einen Modell-Download (docs/voice.md).
CAT_VOICE=false
CAT_STT_MODEL=small
CAT_STT_THREADS=3
CAT_TTS_VOICE=de_DE-thorsten-medium
CAT_VAD_SILENCE_S=1.5
