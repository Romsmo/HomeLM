# Kopieren nach .env und anpassen. Keine echten Werte ins Repo.

# Netzwerk (nur docker-compose): an welche Adresse/Port auf dem Host gebunden wird.
# Auf dem Server: CAT_BIND_ADDR=192.168.0.10 (niemals 0.0.0.0, der Server ist über Caddy öffentlich).
CAT_BIND_ADDR=127.0.0.1
CAT_HOST_PORT=8090
# Benutzer im Container = Besitzer von ./data auf dem Host (Server: id -u / id -g des Deploy-Benutzers).
CAT_UID=10001
CAT_GID=10001

# Backend
CAT_LOG_LEVEL=info

# Login der Weboberfläche. Ohne Passwort ist kein Login möglich. Eigenes, langes Passwort wählen.
CAT_PASSWORD=
# Schlüssel für Sitzungs-Cookies (zufällige lange Zeichenfolge). Leer: Sitzungen enden bei jedem Neustart.
CAT_SESSION_SECRET=

# LLM (Phase 2). Den Schlüssel selbst eintragen, nie im Chat oder im Repo. Ausgabenlimit beim Anbieter setzen.
ANTHROPIC_API_KEY=
CAT_LLM_MODEL=anthropic/claude-haiku-5-5
# "agent" (Standard) oder "echo" (nur Echo, zum Testen der Oberfläche ohne LLM)
CAT_RESPONDER=agent

# Plugins (kommagetrennt): system, weather, openhab, homeassistant (nur mit Home Assistant).
CAT_PLUGINS=system,weather,openhab

# Gerätesteuerung: readonly (nur lesen, Standard), test (nur Testgeräte), full (alle Allowlist-Geräte).
# Erst nach ausdrücklicher Freigabe auf full stellen. Siehe docs/devices.md.
CAT_DEVICE_CONTROL=readonly
# openHAB läuft im Host-Netzwerk des Servers. Token ist optional.
CAT_OPENHAB_URL=http://host.docker.internal:8080
CAT_OPENHAB_TOKEN=
# Wetter-Widget (Open-Meteo, ohne Schlüssel). Ohne Koordinaten zeigt das Widget einen Hinweis.
CAT_WEATHER_LAT=
CAT_WEATHER_LON=
CAT_WEATHER_NAME=
