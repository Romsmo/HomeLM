# Kopieren nach .env und anpassen. Keine echten Werte ins Repo.

# Netzwerk (nur docker-compose): an welche Adresse/Port auf dem Host gebunden wird.
# Auf dem Server: CAT_BIND_ADDR=192.168.0.10 (niemals 0.0.0.0, der Server ist über Caddy öffentlich).
CAT_BIND_ADDR=127.0.0.1
CAT_HOST_PORT=8080

# Backend
CAT_LOG_LEVEL=info
